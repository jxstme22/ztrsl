{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Squad Translator",
  "version": "0.1.0",
  "identifier": "app.localsquadtranslator.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Local Squad Translator",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "Local Squad Translator Captions",
        "url": "index.html?window=overlay",
        "width": 840,
        "height": 260,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
