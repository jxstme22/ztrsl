{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yTRSLT",
  "version": "0.5.7",
  "identifier": "app.localsquadtranslator.desktop",
  "build": {
    "beforeDevCommand": "pnpm ensure:runner && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm ensure:runner && node ../../scripts/build-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "yTRSLT",
        "width": 995,
        "height": 904,
        "minWidth": 994,
        "minHeight": 904,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "shadow": false
      },
      {
        "label": "overlay",
        "title": "yTRSLT Captions",
        "url": "index.html?window=overlay",
        "width": 900,
        "height": 150,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "resources": ["sidecars/"]
  }
}
